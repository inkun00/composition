rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == "inkun00@hanmail.net";
    }

    function ownsAlbum(albumId) {
      return request.auth != null
        && get(/databases/$(database)/documents/communityAlbums/$(albumId)).data.ownerId == request.auth.uid;
    }

    function validLockedAlbum(albumId, album) {
      return album.get("locked", false) == false || (
        album.get("passwordSalt", "") is string
        && album.passwordSalt.size() == 32
        && existsAfter(/databases/$(database)/documents/albumSecrets/$(albumId))
        && getAfter(/databases/$(database)/documents/albumSecrets/$(albumId)).data.ownerId == request.auth.uid
        && getAfter(/databases/$(database)/documents/albumSecrets/$(albumId)).data.proof is string
      );
    }

    function canEnterAlbum(albumId) {
      let album = get(/databases/$(database)/documents/communityAlbums/$(albumId)).data;
      return album.get("locked", false) == false || (request.auth != null && (
        album.ownerId == request.auth.uid || (
          exists(/databases/$(database)/documents/albumMemberAccess/$(albumId)/users/$(request.auth.uid))
          && exists(/databases/$(database)/documents/albumSecrets/$(albumId))
          && get(/databases/$(database)/documents/albumMemberAccess/$(albumId)/users/$(request.auth.uid)).data.proof
            == get(/databases/$(database)/documents/albumSecrets/$(albumId)).data.proof
        )
      ));
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /scores/{scoreId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.ownerId == userId
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 60
          && request.resource.data.songLength is int
          && request.resource.data.songLength >= 8;
      }
    }

    match /albumCreatorAccess/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list, delete: if false;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(["code"])
        && request.resource.data.code == "maeum";
    }

    match /albumSecrets/{albumId} {
      allow read: if false;
      allow create, update: if request.auth != null
        && existsAfter(/databases/$(database)/documents/communityAlbums/$(albumId))
        && getAfter(/databases/$(database)/documents/communityAlbums/$(albumId)).data.ownerId == request.auth.uid
        && getAfter(/databases/$(database)/documents/communityAlbums/$(albumId)).data.locked == true
        && request.resource.data.keys().hasOnly(["ownerId", "proof"])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.proof is string
        && request.resource.data.proof.size() == 64;
      allow delete: if request.auth != null && (ownsAlbum(albumId) || isAdmin());
    }

    match /albumMemberAccess/{albumId}/users/{userId} {
      allow read, delete: if false;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && get(/databases/$(database)/documents/communityAlbums/$(albumId)).data.get("locked", false) == true
        && request.resource.data.keys().hasOnly(["proof"])
        && request.resource.data.proof is string
        && request.resource.data.proof
          == get(/databases/$(database)/documents/albumSecrets/$(albumId)).data.proof;
    }

    match /communityAlbums/{albumId} {
      allow read: if true;
      allow create: if request.auth != null
        && exists(/databases/$(database)/documents/albumCreatorAccess/$(request.auth.uid))
        && get(/databases/$(database)/documents/albumCreatorAccess/$(request.auth.uid)).data.code == "maeum"
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.ownerName is string
        && request.resource.data.ownerName.size() <= 40
        && validLockedAlbum(albumId, request.resource.data);
      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid
        && validLockedAlbum(albumId, request.resource.data);
      allow delete: if request.auth != null
        && (resource.data.ownerId == request.auth.uid || isAdmin());

      match /songs/{songId} {
        allow get: if canEnterAlbum(albumId);
        allow list: if canEnterAlbum(albumId) || isAdmin();
        allow create: if request.auth != null
          && exists(/databases/$(database)/documents/communityAlbums/$(albumId))
          && canEnterAlbum(albumId)
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.sourceScoreId is string
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 60
          && request.resource.data.creator is string
          && request.resource.data.creator.size() <= 40
          && request.resource.data.access in ["audio", "score", "project"]
          && request.resource.data.draft is map;
        allow update: if request.auth != null
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == request.auth.uid
          && canEnterAlbum(albumId)
          && request.resource.data.access in ["audio", "score", "project"];
        allow delete: if request.auth != null
          && (resource.data.ownerId == request.auth.uid || ownsAlbum(albumId) || isAdmin());
      }
    }

    match /qrSongs/{songId} {
      allow get: if true;
      allow list: if false;
      allow create: if request.resource.data.keys().hasOnly(["createdAt", "composition"])
        && request.resource.data.createdAt is timestamp
        && request.resource.data.composition is map
        && request.resource.data.composition.version == 1
        && request.resource.data.composition.title is string
        && request.resource.data.composition.title.size() > 0
        && request.resource.data.composition.title.size() <= 60
        && request.resource.data.composition.creator is string
        && request.resource.data.composition.creator.size() > 0
        && request.resource.data.composition.creator.size() <= 40
        && request.resource.data.composition.songLength is int
        && request.resource.data.composition.songLength >= 8
        && request.resource.data.composition.measures is list
        && request.resource.data.composition.measures.size() == request.resource.data.composition.songLength;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
